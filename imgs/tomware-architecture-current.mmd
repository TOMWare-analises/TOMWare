%% TOMWare.M — arquitetura: Módulos (empacotadores via parâmetros) → Contramedidas
%% Nomes dos módulos ≠ nomes das contramedidas (conforme diagrama)
%% Render: https://mermaid.live

flowchart TD
  mainTw["TOMWare.M Main"]
  core["Instrumentation"]
  params["Parâmetros<br/>-da -dd -de -dm -do -dp"]

  subgraph mods ["Módulos empacotadores"]
    mDd["AntiDeb"]
    mDp["ProcessE"]
    mDe["SanitizePin"]
    mDm["InstMem"]
    mDo["SkewM"]
  end

  subgraph cms ["Contramedidas"]
    cDd["AntiDebug"]
    cDp["ProcessEnum"]
    cDe["SanitizePinEnvVars"]
    cDm["InstMemcmpMask"]
    cDo["SkewMask"]
  end

  peb["PEB BeingDebugged NtGlobalFlag env PIN"]
  apis["APIs Process32 memcmp Sleep QPC"]
  sigs[("Signatures -sf")]
  cal["Calibrate Mask"]

  mainTw --> core
  core --> params
  params --> mDd
  params --> mDp
  params --> mDe
  params --> mDm
  params --> mDo

  mDd -->|"aciona"| cDd
  mDp -->|"aciona"| cDp
  mDe -->|"aciona"| cDe
  mDm -->|"aciona"| cDm
  mDo -->|"aciona"| cDo

  cDd --> peb
  cDe --> peb
  cDp --> apis
  cDm --> apis
  cDo --> apis
  cDm -->|"Verify"| sigs
  cDo --> cal
  cal -->|"Result"| cDo
